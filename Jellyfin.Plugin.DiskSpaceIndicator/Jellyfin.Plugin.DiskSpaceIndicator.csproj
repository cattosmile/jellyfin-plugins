<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.DiskSpaceIndicator</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.DiskSpaceIndicator</AssemblyName>
    <Version>0.1.1.0</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.11">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Web\DiskSpaceIndicator.html" />
    <EmbeddedResource Include="Web\DiskSpaceIndicator.html" />
    <None Remove="Web\disk-space-indicator.js" />
    <EmbeddedResource Include="Web\disk-space-indicator.js" />
  </ItemGroup>

</Project>
